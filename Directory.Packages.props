<Project>
  <!-- 中央包版本管理 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- CLI 框架 -->
    <PackageVersion Include="System.CommandLine" Version="2.0.11" />
    <!-- 模板引擎（7.0.0+ 修复 object.to_json 无深度递归 DoS 等
         GHSA-xcx6-vp38-8hr5/高 7.5 系列漏洞） -->
    <PackageVersion Include="Scriban" Version="7.4.0" />
    <!-- Markdown 解析 -->
    <PackageVersion Include="Markdig" Version="1.3.2" />
    <!-- 图像处理（保持 3.x：4.x 起 Six Labors Split License 在 Release 构建强制
         校验商业许可证，3.1.12 为 Apache 2.0 的 3.x 线最新维护版） -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 配置解析 -->
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Sass/SCSS 编译 -->
    <PackageVersion Include="DartSassHost" Version="2.0.11" />
    <PackageVersion Include="DartSass.Native.win-x64" Version="1.104.0" />
    <PackageVersion Include="DartSass.Native.linux-x64" Version="1.104.0" />
    <!-- osx-x64 包已更名 macos-x64（旧名 1.81.0 后停更） -->
    <PackageVersion Include="DartSass.Native.macos-x64" Version="1.104.0" />
    <!-- HTML/CSS/JS 压缩 -->
    <PackageVersion Include="NUglify" Version="1.22.4" />
    <!-- JavaScript 引擎（用于 DartSassHost） -->
    <PackageVersion Include="JavaScriptEngineSwitcher.V8" Version="3.35.2" />
    <PackageVersion Include="JavaScriptEngineSwitcher.V8.Native.win-x64" Version="3.35.2" />
    <PackageVersion Include="JavaScriptEngineSwitcher.V8.Native.linux-x64" Version="3.35.2" />
    <PackageVersion Include="JavaScriptEngineSwitcher.V8.Native.osx-x64" Version="3.35.2" />
    <!-- 测试框架 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <!-- 性能测试框架 -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
