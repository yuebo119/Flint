<Project>
  <!-- 中央包版本管理 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- CLI 框架 -->
    <PackageVersion Include="System.CommandLine" Version="2.0.12" />
    <!-- 模板引擎（7.0.0+ 修复 object.to_json 无深度递归 DoS 等
         GHSA-xcx6-vp38-8hr5/高 7.5 系列漏洞） -->
    <PackageVersion Include="Scriban" Version="7.5.0" />
    <!-- Markdown 解析 -->
    <PackageVersion Include="Markdig" Version="1.4.0" />
    <!-- 图像处理（2026-09-24 用户裁决：不采用付费版本，锁定开源线——
         4.x 起 Six Labors Split License 在 Release 构建强制校验商业许可证，
         商业用途需付费授权；3.1.12 为 Apache 2.0 的 3.x 线最新维护版，
         4.1.2 复核仍为 Split License。升级前须重新评估授权，不得直接升 4.x） -->
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <!-- 配置解析 -->
    <PackageVersion Include="Tomlyn" Version="2.10.1" />
    <PackageVersion Include="YamlDotNet" Version="18.1.0" />
    <!-- Sass/SCSS 编译 -->
    <PackageVersion Include="DartSassHost" Version="2.0.13" />
    <PackageVersion Include="DartSass.Native.win-x64" Version="1.105.0" />
    <PackageVersion Include="DartSass.Native.linux-x64" Version="1.105.0" />
    <!-- osx-x64 包已更名 macos-x64（旧名 1.81.0 后停更）；
         注意 Flint.Core.csproj 曾引用旧名 osx-x64，macOS 构建 CPM 解析失败，
         2026-09-24 已同步改为 macos-x64 -->
    <PackageVersion Include="DartSass.Native.macos-x64" Version="1.105.0" />
    <!-- HTML/CSS/JS 压缩 -->
    <PackageVersion Include="NUglify" Version="1.23.1" />
    <!-- JavaScript 引擎（用于 DartSassHost） -->
    <PackageVersion Include="JavaScriptEngineSwitcher.V8" Version="3.35.2" />
    <PackageVersion Include="JavaScriptEngineSwitcher.V8.Native.win-x64" Version="3.35.2" />
    <PackageVersion Include="JavaScriptEngineSwitcher.V8.Native.linux-x64" Version="3.35.2" />
    <PackageVersion Include="JavaScriptEngineSwitcher.V8.Native.osx-x64" Version="3.35.2" />
    <!-- 测试框架 -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FsCheck" Version="3.4.0" />
    <PackageVersion Include="FsCheck.Xunit" Version="3.4.0" />
    <PackageVersion Include="FsCheck.Xunit.v3" Version="3.4.0" />
    <PackageVersion Include="coverlet.collector" Version="10.0.1" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <!-- 性能测试框架 -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
</Project>
