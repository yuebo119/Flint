<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    
    <!-- 禁用 NuGet 安全漏洞审计（避免第三方包漏洞导致构建失败） -->
    <!-- 注意：生产环境应定期检查并更新有漏洞的包 -->
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>

  <!-- Native AOT 配置（T1.11 澄清，2026-10-11）：对 Release 生效于全部项目——
       DevTools/AiGate/ThemeMigrator 无覆盖即真 AOT 发布；唯一例外是 Flint.Cli
       显式 PublishAot=false（无参 publish = R2R 单文件），其正式 AOT 发布走
       命令行 -p:PublishAot=true 覆盖（README「构建」节口径）。IsAotCompatible
       分析在 Flint.Core 常开，与发布形态解耦 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <!-- 性能优先（2026-10-13 极致性能轮）：SSG 的热路径是 Scriban 解释循环与
         Markdig 解析，Size 偏好抑制 ILC 内联/向量化，牺牲稳态吞吐。代价为
         二进制增大（~28MB → ~35-40MB 量级），构建工具接受该取舍 -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcDisableReflection>false</IlcDisableReflection>
    <StripSymbols>true</StripSymbols>
    <!-- 不开 InvariantGlobalization（2026-10-22 审计）：该模式下 ICU/tzdata
         整体缺席，TimeZoneInfo 既解析不了 IANA 名（Asia/Shanghai，README 示例值）
         也解析不了 TryConvertIanaIdToWindowsId 这类自带的映射表，配置 timeZone
         直接中止构建。跨机器输出确定性改由启动期显式钉 InvariantCulture 保证
         （CultureInfo.DefaultThreadCurrentCulture），不依赖"移除 ICU"这一副作用 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 版本信息 -->
  <PropertyGroup>
    <Version>0.2.1</Version>
    <Authors>Flint Team</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Company>Flint</Company>
    <Product>Flint Static Site Generator</Product>
    <Description>高性能静态站点生成器，使用 .NET 10+ 和 Native AOT 构建</Description>
  </PropertyGroup>
</Project>
