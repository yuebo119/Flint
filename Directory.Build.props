<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>15.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningLevel>9999</WarningLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-all</AnalysisLevel>
    
    <!-- NuGet 安全漏洞审计（R1 审计 HYG-I1，2026-11-21 开启）：
         此前 NuGetAudit=false 让构建期完全看不到第三方包公告。现开启审计，
         并只把审计类警告从"错误"降回"警告"——TreatWarningsAsErrors=true 下
         若不降级，未来任何新公告都会直接阻断构建（官方推荐形态：
         WarningsNotAsErrors 而非 NoWarn，警告仍打印可见）。
         注意：审计要真正产出报告，还须在 nuget.config 显式配置 auditSources
         （未配置时回落到 packageSources 且 NU1905 被抑制，实测静默无报告）。 -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904;NU1905</WarningsNotAsErrors>
  </PropertyGroup>

  <!-- NuGet 审计的公告压制（R1 审计 HYG-I1，2026-11-21）。
       适用对象：SixLabors.ImageSharp 锁定 3.1.12（许可死结下的既定裁决，
       见 Directory.Packages.props 该包注释）。
       压制理由：6 条公告集中在 TIFF 解码/编码、ICC CLUT、HistogramEqualization；
       Flint 的解码白名单只允许 PNG/JPEG/GIF/WebP/BMP（见 ImageProcessor 的格式
       校验），TIFF 路径不可达；ICC/直方图链未在 Flint 的图像处理路径触达。
       编号来源：dotnet list package 的 vulnerable 查询与 restore 的 NU1902/NU1903
       输出一手核对（2026-11-21，两处 URL 完全一致）。
       按要求，压制属最后手段——它对该公告是全局压制（共享同一公告的其他包也
       不再报）。复核触发：ImageSharp 许可方案变更、或升级到 3.2.x/4.x 时，
       连同本 ItemGroup 一起移除。
       未压制的公告（未来新增）仍会以 NU1902/NU1903 警告出现，不阻断构建。 -->
  <ItemGroup>
    <!-- High -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-v76p-62qx-wwq2" />
    <!-- Moderate -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
  </ItemGroup>

  <!-- Native AOT 配置（T1.11 澄清，2026-10-11）：对 Release 生效于全部项目——
       DevTools/AiGate/ThemeMigrator 无覆盖即真 AOT 发布；唯一例外是 Flint.Cli
       显式 PublishAot=false（无参 publish = R2R 单文件），其正式 AOT 发布走
       命令行 -p:PublishAot=true 覆盖（README「构建」节口径）。IsAotCompatible
       分析在 Flint.Core 常开，与发布形态解耦 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
    <!-- 性能优先（2026-10-13 极致性能轮）：SSG 的热路径是 Scriban 解释循环与
         Markdig 解析，Size 偏好抑制 ILC 内联/向量化，牺牲稳态吞吐。代价为
         二进制增大（~28MB → ~35-40MB 量级），构建工具接受该取舍 -->
    <OptimizationPreference>Speed</OptimizationPreference>
    <IlcOptimizationPreference>Speed</IlcOptimizationPreference>
    <IlcGenerateStackTraceData>false</IlcGenerateStackTraceData>
    <IlcDisableReflection>false</IlcDisableReflection>
    <StripSymbols>true</StripSymbols>
    <!-- 不开 InvariantGlobalization（2026-10-22 审计）：该模式下 ICU/tzdata
         整体缺席，TimeZoneInfo 既解析不了 IANA 名（Asia/Shanghai，README 示例值）
         也解析不了 TryConvertIanaIdToWindowsId 这类自带的映射表，配置 timeZone
         直接中止构建。跨机器输出确定性改由启动期显式钉 InvariantCulture 保证
         （CultureInfo.DefaultThreadCurrentCulture），不依赖"移除 ICU"这一副作用 -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- 版本信息 -->
  <PropertyGroup>
    <Version>0.4.0</Version>
    <Authors>Flint Team</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Company>Flint</Company>
    <Product>Flint Static Site Generator</Product>
    <Description>高性能静态站点生成器，使用 .NET 11+ 和 Native AOT 构建</Description>
  </PropertyGroup>
</Project>
