<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet 配置（2026-11-21 新增）
  目的：让 NuGetAudit 真正产出漏洞警告。
  背景：NuGetAudit=true 已在 Directory.Build.props 求值正确，但实测 restore 与 build
  均不产出 NU1902/NU1903（SDK 11.0.100、TFM net11.0、全新还原 + 清 http 缓存复现）。
  按 NuGet 文档，未定义 auditSources 时回落到 packageSources 且 NU1905 被抑制；
  显式指向 nuget.org 的漏洞数据专用索引，使审计有明确数据源。
  packageSources 不动（沿用全局配置的源列表）。
-->
<configuration>
  <auditSources>
    <add key="nuget.org-vulnerabilities" value="https://data.nuget.org/v3/index.json" />
  </auditSources>
</configuration>
