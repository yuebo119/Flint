~$*
performance-report.html

# 性能基准语料与工具（大体积本地数据，脚本可再生，不入库；
# benchmarks/reports/ 与 README.md 仍入库）
benchmarks/corpus/

# 本地基准工具二进制（hugo.exe / flint-aot 发布产物）不入库
benchmarks/tools/
.serena/

# 临时探测站与编译缓存
temp-*/
__pycache__/
*.pyc

# 主题迁移项目（theme-migrator/）：主题语料缓存，可再生不入库
# （candidates = 上游 Hugo 主题抓取缓存；themes = 转换产出，重建流程见该项目 README）
/theme-migrator/themes/
/theme-migrator/candidates/

# 案例站项目（demo-sites/）：构建产物与站点内迁移主题（demo-sites.sh 每次重建生成）
/demo-sites/*/public/
/demo-sites/*/themes/
/demo-sites/gallery/public/
matrix20/
