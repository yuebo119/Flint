<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Flint.PerformanceTests</RootNamespace>
    <AssemblyName>Flint.PerformanceTests</AssemblyName>
    <Description>Flint 性能测试工具</Description>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    
    <!-- 禁用 AOT 相关警告（性能测试不需要 AOT） -->
    <PublishAot>false</PublishAot>
    <IsAotCompatible>false</IsAotCompatible>
    
    <!-- 禁用不必要的警告 -->
    <NoWarn>$(NoWarn);CA1707;CA1861;CA5394;CA1515;CA1307;CA1822;CA1031;CA1062;CA2007;CA1002;CA1852;IL2026;IL3050;CA1303;CA1305</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Flint.Core\Flint.Core.csproj" />
  </ItemGroup>

</Project>
