<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SsgMatrix.Statiq</RootNamespace>
    <AssemblyName>SsgMatrix.Statiq</AssemblyName>

    <!-- 基准工具：不受仓库级分析器与警告即错误约束 -->
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <PublishAot>false</PublishAot>
    <IsPackable>false</IsPackable>

    <!-- 基准工程自带版本控制，退出仓库中央包管理（CPM 禁止 PackageReference 行内版本） -->
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>

    <!-- 实测臂为 Statiq 源码 main 构建；默认用 NuGet 最新包复现（1.0.0-beta.60）。
         要完全对齐实测版本：
           dotnet build benchmarks/ssg-matrix/statiq -c Release \
             -p:StatiqWebProject=<克隆目录>/src/extensions/Statiq.Web/Statiq.Web.csproj -->
    <StatiqWebVersion Condition="'$(StatiqWebVersion)' == ''">1.0.0-beta.60</StatiqWebVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(StatiqWebProject)' != ''">
    <ProjectReference Include="$(StatiqWebProject)" />
  </ItemGroup>

  <ItemGroup Condition="'$(StatiqWebProject)' == ''">
    <PackageReference Include="Statiq.Web" Version="$(StatiqWebVersion)" />
  </ItemGroup>

</Project>
