<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 批处理吞吐：Server GC 多核并行回收（万页构建 GC 压力大，Workstation
         GC 单线程回收在多核机器上是吞吐瓶颈） -->
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- 项目基本信息 -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Flint.Cli</RootNamespace>
    <AssemblyName>Flint</AssemblyName>
    <Description>Flint 静态站点生成器命令行工具</Description>
    
    <!-- 禁用 CLI 应用程序不需要的代码分析规则 -->
    <NoWarn>$(NoWarn);CA1303;CA1515;CA1822;CA1031;CA2007;CA1305;CA1307;IL2026;IL3050;IL2075;IL2104</NoWarn>
    
    <!-- AOT 双形态（T1.11 澄清，2026-10-11）：本项默认 false → 无参 dotnet publish
         产出 R2R 单文件（快速迭代口径，~89MB）；**正式发布是 NativeAOT 单文件**，
         由命令行覆盖：dotnet publish -c Release -r win-x64 -p:PublishAot=true
         （~28MB，README「构建」节的官方口径，bench 基线也用该形态）。
         VYaml/Scriban 的解析路径在 AOT 下以裁剪根 + 运行时探针覆盖（见
         TrimmerRootAssembly 与 AiGate 的 AOT 门禁），并非"禁用 AOT"的理由 -->
    <PublishAot>false</PublishAot>
    <SelfContained>true</SelfContained>
    
    <!-- 发布为单文件 -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    
    <!-- 启用 ReadyToRun 预编译以提升启动性能 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    
    <!-- 启用部分裁剪（AOT 优化） -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    
    <!-- 允许不安全代码（用于 SIMD 优化） -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    
    <!-- 启动性能优化 -->
    <TieredCompilation>false</TieredCompilation>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- 发布配置 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <!-- 裁剪时保留的程序集（需要反射的库） -->
  <ItemGroup>
    <TrimmerRootAssembly Include="Scriban" />
  </ItemGroup>

  <ItemGroup>
    <!-- 项目引用 -->
    <ProjectReference Include="..\Flint.Core\Flint.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CLI 框架 -->
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

</Project>
